# Copy this file to .env and adjust values for your local PostgreSQL instance.
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ASP.NET Core nested configuration keys use double underscores.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=school_admission;Username=postgres;Password=postgres

VITE_API_BASE_URL=http://localhost:8080
